# ---------------------------------------------------------------------------------------------------
# Ana research backend (Supabase). Copy this file to `.env.local` and fill in your values.
# `.env`, `.env.local` and every `.env.*` except this example are git-ignored. Never commit real keys.
# See docs/RESEARCH_DATA_SYSTEM.md, "Setup".
# ---------------------------------------------------------------------------------------------------

# --- SERVER-SIDE ONLY ------------------------------------------------------------------------------
# Read by the research API (Vite dev/preview middleware, or your server/Vercel function).
# These are NOT prefixed with VITE_, so Vite never puts them in the browser bundle.
# Supabase dashboard > Project Settings > API (Data API): "Project URL".
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard > Project Settings > API Keys: the "service_role" (secret) key.
# Full database access. Server only. Never paste it into anything that starts with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables the internal records view at /api/research/debug/page (development only).
# Any long random string (16+ characters). Leave empty to keep the debug view switched off.
RESEARCH_DEBUG_KEY=

# --- BROWSER (safe to expose) ------------------------------------------------------------------------
# Where the research client sends writes. Default: same origin, /api/research.
VITE_RESEARCH_API_BASE=/api/research
# Set to "false" to switch research logging off entirely in a build.
VITE_RESEARCH_ENABLED=true

# --- Research dashboard (/research) -----------------------------------------------------------------
# The dashboard reads through the server-side API with the service role above; it needs no browser key.
# Optional, server-only: when set, /research needs this key (open /research?key=<value> once).
RESEARCH_DASHBOARD_KEY=
