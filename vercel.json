{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/studio/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/studio/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/studio/video/:path*",
      "destination": "/video/:path*"
    },
    {
      "source": "/studio/icons/:path*",
      "destination": "/icons/:path*"
    },
    {
      "source": "/studio/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/api/research/(.*)",
      "destination": "/api/research?action=$1"
    },
    {
      "source": "/test",
      "destination": "/index.html"
    },
    {
      "source": "/research",
      "destination": "/index.html"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/studio/compare",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/research",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/test",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio/compare",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
